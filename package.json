{
  "name": "dsh-aliyunpan-backup",
  "version": "0.3.0",
  "description": "DSH 备份与同步插件：一条链路把配置/插件装配/会话/附件打包成 AES-256-GCM 加密快照传到阿里云盘，另一条链路按目录做增量镜像同步（一主多从）。设置→插件里有带图标的配置界面。",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "icon": "icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "aliyunpan",
    "backup",
    "encrypted-backup"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LYF-12/dsh-aliyunpan-backup.git"
  },
  "bugs": {
    "url": "https://github.com/LYF-12/dsh-aliyunpan-backup/issues"
  },
  "homepage": "https://github.com/LYF-12/dsh-aliyunpan-backup#readme"
}
