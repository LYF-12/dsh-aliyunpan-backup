{
  "name": "dsh-aliyunpan-backup",
  "version": "0.6.3",
  "description": "把 DeepSeek Harness 数据备份/同步到阿里云盘的 DSH 插件；可选密钥信封（AES-256-GCM 加密同步登录凭据）；映射与合并工作区、拉取不覆盖本机更新、可诊断运行日志与同步看门狗；零运行时依赖",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "icon": "icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/safety.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "aliyunpan",
    "sync",
    "cloud-sync",
    "decode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LYF-12/dsh-aliyunpan-backup.git"
  },
  "bugs": {
    "url": "https://github.com/LYF-12/dsh-aliyunpan-backup/issues"
  },
  "homepage": "https://github.com/LYF-12/dsh-aliyunpan-backup#readme"
}
