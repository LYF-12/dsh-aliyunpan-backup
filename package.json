{
  "name": "dsh-aliyunpan-backup",
  "version": "0.4.0",
  "description": "DSH 云同步插件：把 .dsh 里选定的目录（会话/附件/素材/配置等）逐目录增量镜像到阿里云盘，一主多从；随时拉回另一台机器的改动。附带本地包解码器，可校验/解包任意 payload.enc（含别人分享的）。设置→插件里有带图标的配置界面。",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "icon": "icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "aliyunpan",
    "sync",
    "cloud-sync",
    "decode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LYF-12/dsh-aliyunpan-backup.git"
  },
  "bugs": {
    "url": "https://github.com/LYF-12/dsh-aliyunpan-backup/issues"
  },
  "homepage": "https://github.com/LYF-12/dsh-aliyunpan-backup#readme"
}
