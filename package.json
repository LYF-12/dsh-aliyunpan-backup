{
  "name": "dsh-aliyunpan-backup",
  "version": "0.1.0",
  "description": "把 DSH 配置 / 插件装配 / 会话 / 附件打包成加密快照并同步到阿里云盘的 DSH 插件：设置→插件里有一个带图标的配置界面，一条命令完成打包、上传、校验、按份数清理。",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "icon": "icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "aliyunpan",
    "backup",
    "encrypted-backup"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LYF/dsh-aliyunpan-backup.git"
  },
  "bugs": {
    "url": "https://github.com/LYF/dsh-aliyunpan-backup/issues"
  },
  "homepage": "https://github.com/LYF/dsh-aliyunpan-backup#readme"
}
